+// WaitReady verifies the context's own shell channel, not a transient server nudge socket.
+// Actor code is submitted only after this request has a matching reply.
+func (c *Client) WaitReady() error {
+    c.mu.Lock()
+    started := c.channelReady
+    c.mu.Unlock()
+    select {
+    case <-started:
+    case <-time.After(15 * time.Second): return errors.New("kernel websocket startup readiness timed out")
+    }
+    ready := make(chan struct{}, 1)
+    var mu sync.Mutex
+    replies := make(map[string]uint8)
+    mark := func(id string, flag uint8) {
+        mu.Lock()
+        defer mu.Unlock()
+        state, known := replies[id]
+        if !known { return }
+        state |= flag
+        replies[id] = state
+        if state == 3 { select { case ready <- struct{}{}: default: } }
+    }
+    c.registerHandler(MsgKernelInfoReply, func(reply *Message) {
+        mark(reply.ParentHeader.MessageID, 1)
+    })
+    c.registerHandler(MsgStatus, func(reply *Message) {
+        var status StatusUpdate
+        if json.Unmarshal(reply.Content, &status) == nil && status.ExecutionState == StateIdle {
+            mark(reply.ParentHeader.MessageID, 2)
+        }
+    })
+    send := func() error {
+        msg, err := c.buildExecuteMessage("")
+        if err != nil { return err }
+        msg.Header.MessageType = string(MsgKernelInfo)
+        msg.Content = json.RawMessage(`{}`)
+        mu.Lock()
+        replies[msg.Header.MessageID] = 0
+        mu.Unlock()
+        return c.writeMessage(msg)
+    }
+    if err := send(); err != nil { return err }
+    deadline := time.NewTimer(15 * time.Second)
+    defer deadline.Stop()
+    ticker := time.NewTicker(500 * time.Millisecond)
+    defer ticker.Stop()
+    for {
+        select {
+        case <-ready: return nil
+        case <-ticker.C:
+            // Each harmless probe gets a fresh signature; Actor code is never replayed.
+            if err := send(); err != nil { return err }
+        case <-deadline.C: return errors.New("kernel shell/iopub channel readiness timed out")
+        }
+    }
 }
 
