    "program_id",
    "as_of",
    "settled_principal",
    "refund_claim",
    "tooling_disposition",
    "incremental_exposure",
    "technical_admissibility",
    "recovery_feasibility",
    "change_scope"
  ],
  "properties": {
    "program_id": {
      "type": "string"
    },
    "as_of": {
      "type": "string"
    },
    "settled_principal": {
      "type": "object",
      "required": [
        "currency",
        "categories",
        "total_paid_minor"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "enum": [
            "CNY",
            "USD",
            "EUR"
          ]
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "category",
              "paid_minor"
            ],
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "tooling",
                  "rd"
                ]
              },
              "paid_minor": {
                "type": "integer",
                "description": "Currency minor units, 100 per major unit; tolerance one minor unit."
              }
            },
            "additionalProperties": true
          },
          "description": "Compare as unordered business rows by stable keys; submit in supplier, category, variant or fiscal-period order. Duplicate rows invalid."
        },
        "total_paid_minor": {
          "type": "integer",
          "description": "Currency minor units, 100 per major unit; tolerance one minor unit."
        }
      },
      "additionalProperties": true
    },
    "refund_claim": {
