              "upfront_rd_minor": {
                "type": "integer",
                "description": "Currency minor units, 100 per major unit; tolerance one minor unit."
              },
              "upfront_transition_minor": {
                "type": "integer",
                "description": "Currency minor units, 100 per major unit; tolerance one minor unit."
              },
              "gross_total_minor": {
                "type": "integer",
                "description": "Currency minor units, 100 per major unit; tolerance one minor unit."
              },
              "gross_npv_minor": {
                "type": "integer",
                "description": "Currency minor units, 100 per major unit; tolerance one minor unit."
              }
            },
            "additionalProperties": true
