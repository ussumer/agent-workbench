                  "properties": {
                    "fiscal_period": {
                      "type": "integer",
                      "description": "Exact integer; no quantity, year, duration or day tolerance."
                    },
                    "operating_minor": {
                      "type": "integer",
                      "description": "Currency minor units, 100 per major unit; tolerance one minor unit."
                    },
                    "tooling_minor": {
                      "type": "integer",
                      "description": "Currency minor units, 100 per major unit; tolerance one minor unit."
                    },
                    "gross_minor": {
                      "type": "integer",
                      "description": "Currency minor units, 100 per major unit; tolerance one minor unit."
                    }
