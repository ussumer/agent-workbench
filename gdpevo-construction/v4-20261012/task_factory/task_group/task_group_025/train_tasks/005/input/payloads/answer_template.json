                  "tooling",
                  "rd"
                ]
              },
              "claim_minor": {
                "type": "integer",
                "description": "Currency minor units, 100 per major unit; tolerance one minor unit."
              },
              "received_minor": {
                "type": "integer",
                "description": "Currency minor units, 100 per major unit; tolerance one minor unit."
              },
              "outstanding_minor": {
                "type": "integer",
                "description": "Currency minor units, 100 per major unit; tolerance one minor unit."
              }
            },
            "additionalProperties": true
          },
          "description": "Compare as unordered business rows by stable keys; submit in supplier, category, variant or fiscal-period order. Duplicate rows invalid."
        },
        "claim_minor": {
          "type": "integer",
          "description": "Currency minor units, 100 per major unit; tolerance one minor unit."
        },
        "received_minor": {
          "type": "integer",
          "description": "Currency minor units, 100 per major unit; tolerance one minor unit."
        },
        "outstanding_minor": {
          "type": "integer",
          "description": "Currency minor units, 100 per major unit; tolerance one minor unit."
        },
        "due_date": {
          "type": "string"
        },
        "receipt_status": {
          "type": "string",
          "enum": [
            "unreceived",
            "partial",
            "received"
          ]
        }
      },
      "additionalProperties": true
    },
    "tooling_disposition": {
      "type": "object",
      "required": [
        "title",
        "disposition",
        "reusable",
        "transfer_credit_currency",
        "transfer_credit_minor",
        "credit_is_cash_refund",
        "supplier_owned_stranded"
      ],
      "properties": {
        "title": {
          "type": "string",
          "enum": [
            "customer",
            "supplier"
          ]
        },
        "disposition": {
          "type": "string",
          "enum": [
            "reusable_customer_owned",
            "stranded_supplier_owned",
            "requires_further_agreement"
