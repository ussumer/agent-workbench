# Copy to .env and fill in locally. .env is git-ignored and must never be committed
# or pasted into plan documents, receipts or chat.

# --- Real model used by the procurement assistant and the coding agent ---------
# The runtime model identity comes from configuration; do not infer an API model ID
# from the DSV4.1flash shorthand. Fill in the values your provider actually gave you.
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_ID=

# --- Toolchain locations (optional; auto-detected when empty) ------------------
# JAVA_HOME must point to a JDK directory containing bin/javac, not to java.exe.
JAVA_HOME=
# NODE_HOME must point to the directory containing node/npm.
NODE_HOME=

# --- Local services -----------------------------------------------------------
ERP_BASE_URL=http://localhost:8080
MCP_BASE_URL=http://localhost:8000
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=rush_harness_demo
MONGODB_TEST_DB=rush_harness_test
FIXTURES_BASE_URL=http://localhost:8088
OPENSANDBOX_BASE_URL=http://localhost:18080
OPENSANDBOX_API_KEY=
AGENT_PROTOCOL_BASE_URL=http://localhost:8123

# --- External services --------------------------------------------------------
ZHIPU_API_KEY=
MODELSCOPE_MCP_URL=
MODELSCOPE_API_TOKEN=

# --- Gate behaviour -----------------------------------------------------------
# Per-check subprocess timeout in seconds.
GATE_TIMEOUT_SECONDS=900
