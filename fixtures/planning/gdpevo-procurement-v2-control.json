{
  "schema_version": 2,
  "task_group_id": "chengchuan-procurement-v2",
  "rules": [
    {
      "rule_id": "Q",
      "name": "报价修订与事实权威",
      "condition": "同一供应关系存在多版商务文件",
      "policy": "仅生效且未过期的签章商务文件控制价格/包装；按revision选最新正式版本（signed/pending/revoked）；draft不覆盖正式文件。最新正式revoked关闭本关系，不回退旧价。ERP仍控制active/交期/供货容量，商务文件不能覆盖这些字段。",
      "stop": "未来/过期文件不参与；报价权威不扩展到ERP状态/交期。"
    },
    {
      "rule_id": "U",
      "name": "包装与现场盈余限制",
      "condition": "报价按包装计价，需求按件",
      "policy": "只买整数包，件数=包数×pack_size，按最小包数覆盖剩余需求。depot允许整包盈余；pit_stop每个物料本轮盈余最多1件。可选覆盖只计需求件数，盈余不加分。",
      "stop": "没有剩余需求时不补购；现场限额不能套用到depot。"
    },
    {
      "rule_id": "F",
      "name": "新购物车运费与免邮",
      "condition": "同一供应商本轮有新购行",
      "policy": "运费按每个供应商本轮购物车收一次；仅本轮商品金额>=free_at_cents才免邮（等于也免）。已成交订单金额不计本轮门槛；不同供应商不能合并凑门槛。累计预算包含已成交实付+本轮商品+本轮运费。",
      "stop": "无新购行不收运费；历史运费不再收取。"
    },
    {
      "rule_id": "K",
      "name": "维修配套组闭包",
      "condition": "多个可选需求拥有相同非空kit_id",
      "policy": "同一kit的未完成目标必须全部补足或全部不买；已有成员完成不重新购买。不同kit互不绑定。目标仍按priority数字从小到大最大化可选需求件数，同级合计覆盖后再最小化累计成本。",
      "stop": "空kit_id的需求独立；不把供应商相同误认为配套组。"
    },
    {
      "rule_id": "M",
      "name": "有界证据缺失的决策相关性",
      "condition": "最新正式报价pending，价格只能确定区间",
      "policy": "在未知报价的最低/最高合法包价分别枚举完整计划。若两个边界的可行性及最优覆盖/成本均与仅用已知报价的最优相同，记录pending而不追问；否则needs_information且不提交新订单。不能把资料未决称infeasible，也不能发布假设包价。",
      "stop": "超期/停用/无剩余需求的关系先排除；资料缺失不自动阻断无关已知方案。"
    },
    {
      "rule_id": "A",
      "name": "当前修订审批作用域",
      "condition": "goal revision contains new or changed delta",
      "policy": "历史已购承诺只作为累计事实和对账证据；不能用旧审批直接授权当前追加量。当前revision的每个新追加或变更行必须产生新的审批请求。",
      "stop": "不取消已成交订单；无变化的历史承诺不生成重复订单。"
    }
  ],
