{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rush-harness:schema:order:v1",
  "title": "ERP order resource returned to the gateway",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "order_no",
    "owner_user_id",
    "supplier_id",
    "currency",
    "total_amount",
    "version",
    "created_at",
    "updated_at",
    "lines"
  ],
  "properties": {
    "order_id": { "type": "string", "minLength": 1 },
    "order_no": { "type": "string", "minLength": 1 },
    "owner_user_id": { "type": "string", "minLength": 1 },
    "supplier_id": { "type": "string", "pattern": "^S[0-9]{3}$" },
    "currency": { "const": "CNY" },
    "total_amount": {
      "description": "服务端用 BigDecimal 计算，绝不采纳模型提交的总额",
      "type": "string",
      "pattern": "^[0-9]{1,9}\\.[0-9]{2}$"
    },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "note": { "type": "string", "maxLength": 500 },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["line_no", "part_id", "quantity", "unit_price", "line_amount"],
        "properties": {
          "line_no": { "type": "integer", "minimum": 1, "maximum": 20 },
          "part_id": { "type": "string", "pattern": "^P[0-9]{3}$" },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "unit_price": { "type": "string", "pattern": "^[0-9]{1,6}\\.[0-9]{2}$" },
          "line_amount": { "type": "string", "pattern": "^[0-9]{1,9}\\.[0-9]{2}$" }
        }
      }
    }
  }
}
