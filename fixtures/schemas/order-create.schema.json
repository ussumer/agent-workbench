{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rush-harness:schema:order-create:v1",
  "title": "ERP create order request (POST /api/erp/v1/orders)",
  "type": "object",
  "additionalProperties": false,
  "required": ["supplier_id", "currency", "lines"],
  "properties": {
    "supplier_id": { "type": "string", "pattern": "^S[0-9]{3}$" },
    "currency": { "const": "CNY" },
    "note": { "type": "string", "maxLength": 500 },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/line" }
    }
  },
  "$defs": {
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_id", "quantity", "unit_price"],
      "properties": {
        "part_id": { "type": "string", "pattern": "^P[0-9]{3}$" },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "unit_price": {
          "description": "两位小数金额字符串；0.01..999999.99；不接受三位小数或隐式四舍五入",
          "type": "string",
          "pattern": "^(?:0\\.(?:0[1-9]|[1-9][0-9])|[1-9][0-9]{0,5}\\.[0-9]{2})$"
        }
      }
    }
  }
}
