{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rush-harness:schema:skill-manifest:v1",
  "title": "Published skill manifest stored in the LangGraph Store",
  "description": "不可变版本目录 + manifest + assignment 指针；缺少文件或校验失败都不得发布指针。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slug",
    "version",
    "status",
    "created_at",
    "created_by",
    "source",
    "source_sha256",
    "files",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": {
      "enum": [
        "draft",
        "validating",
        "validated",
        "persisted",
        "assigned",
        "validation_failed",
        "persistence_failed",
        "restore_failed"
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "enum": ["demo-a", "demo-b"] },
    "source": { "enum": ["generated", "package"] },
    "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scripts_entry": {
      "description": "相对技能根目录的脚本入口，例如 scripts/summarise.py",
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {
            "description": "相对技能根目录的 POSIX 路径；不得为绝对路径或包含 ..",
            "type": "string",
            "minLength": 1
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "total_size": {
      "description": "展开后总字节数，上限 10 MiB",
      "type": "integer",
      "minimum": 0,
      "maximum": 10485760
    }
  }
}
